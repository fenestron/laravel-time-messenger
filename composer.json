{
    "name": "fenestron/laravel-time-messenger",
    "description": "Client for the Time messenger REST API: posts, reactions, files, channels and users. Works with or without Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "time-messenger",
        "mattermost",
        "api-client"
    ],
    "authors": [
        {
            "name": "fenestron"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Fenestron\\TimeMessenger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fenestron\\TimeMessenger\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    }
}
